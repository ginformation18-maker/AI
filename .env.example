# Copy this file to .env; never share .env or commit it to Git.
MT5_LOGIN=12345678
MT5_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
MT5_SERVER=REPLACE_WITH_EXACT_BROKER_DEMO_SERVER
# Optional full path to terminal64.exe on Windows:
MT5_TERMINAL_PATH=

# DRY_RUN = analysis only, DEMO = orders on demo, LIVE = real-money orders
MODE=DRY_RUN
SYMBOLS=XAUUSD,EURUSD
TIMEFRAME=M15
POLL_SECONDS=15
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1
MAX_OPEN_POSITIONS=2
MAX_SPREAD_ATR_RATIO=0.10
MAX_QUOTE_AGE_SECONDS=120
MAX_BAR_AGE_SECONDS=120
STOP_ATR_MULTIPLE=1.5
TAKE_PROFIT_ATR_MULTIPLE=2.25
MARGIN_FRACTION_LIMIT=0.20
MAGIC=20261121

# Optional AI veto, no execution authority. Missing/unavailable API -> fail closed.
AI_VETO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LIVE requires both the exact text AND a separately-created local authorization file.
LIVE_ENABLE_TEXT=
