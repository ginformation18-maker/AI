# Copy this file to .env; never share .env or commit it to Git.
MT5_LOGIN=12345678
MT5_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
MT5_SERVER=REPLACE_WITH_EXACT_BROKER_DEMO_SERVER
# Optional full path to terminal64.exe on Windows:
MT5_TERMINAL_PATH=

# DRY_RUN = analysis only, DEMO = orders on demo, LIVE = real-money orders
MODE=DRY_RUN
SYMBOLS=XAUUSD,EURUSD
TIMEFRAME=M15
POLL_SECONDS=15
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1
MAX_OPEN_POSITIONS=2
MAX_SPREAD_ATR_RATIO=0.10
MAX_QUOTE_AGE_SECONDS=120
MAX_BAR_AGE_SECONDS=120
STOP_ATR_MULTIPLE=1.5
TAKE_PROFIT_ATR_MULTIPLE=2.25
MARGIN_FRACTION_LIMIT=0.20
MAGIC=20261121

# Optional AI veto, no execution authority. Missing/unavailable API -> fail closed.
AI_VETO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LIVE requires both the exact text AND a separately-created local authorization file.
LIVE_ENABLE_TEXT=

# PHASE 3.3: Discord observer (local secret; create webhook in the Discord channel)
DISCORD_WEBHOOK_URL=
# AI regime observer only: no orders, no trade approvals, API usage may incur charges.
AGENT_AI_ENABLED=false
AGENT_AI_MODEL=gpt-4.1-mini
AGENT_POLL_SECONDS=60
AGENT_REPORT_SECONDS=1800
AGENT_AI_INTERVAL_SECONDS=3600

# PHASE 3.3 DISCORD DISCUSSION HUB (alternative to Webhook observer above)
# Create one Discord server channel and a Discord App bot with applications.commands + bot scopes.
# Secrets must stay in .env on your PC; never post bot token or API key in Discord.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
AGENT_AUTO_DISCUSS_ENABLED=false
AGENT_AUTO_DISCUSS_INTERVAL_SECONDS=3600
AGENT_MAX_DISCUSSIONS_PER_DAY=6

# PHASE 3.4 — Optional LOCAL model for Discord discussions only (no API bill)
# OpenAI remains the legacy default unless you select ollama explicitly.
AGENT_AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_PREDICT=220
# Only after `scripts\check_ollama.bat` succeeds:
# AGENT_AI_ENABLED=true
# AGENT_AUTO_DISCUSS_ENABLED=true

# PHASE 3.5 — Four separately named Arabic agent messages in ONE Discord channel
# In Discord channel settings > Integrations > Webhooks, create ONE channel webhook.
# Copy URL privately into your local .env; NEVER share or commit it.
AGENT_DISTINCT_NAMES_ENABLED=false
DISCORD_AGENT_WEBHOOK_URL=
# Higher limits use more local RAM/CPU. Bounds: 1..96/day, 300..86400 sec interval.
# Default remains conservative until you explicitly choose otherwise.
AGENT_MANUAL_COOLDOWN_SECONDS=90
